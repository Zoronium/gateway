# Copy to .env and fill in only the providers you use. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=

# Ollama has no key. Set this to switch it on.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional. Default is localhost only.
# LISTEN=127.0.0.1:8080

# Clients send this as "Authorization: Bearer <key>". At least 16 characters.
# Leave it empty and the gateway makes a one-run key and prints it at startup.
GATEWAY_KEY=

# Other Host names clients may use, comma-separated. localhost and 127.0.0.1 always work.
# ALLOWED_HOSTS=gateway.example.com

# Requests running at once before the gateway answers 429. Default 32.
# MAX_INFLIGHT=32

# Most new text, in MB, the filter will scan in one request. Over it, the request is refused
# instead of being sent on unscanned. 0 means no limit. Default 2.
# SCAN_LIMIT_MB=2

# Stats database. Default gateway.db next to where you run the gateway.
# DB_PATH=gateway.db
# Days of per-try history to keep. Default 30.
# STATS_DAYS=30
# Minutes between refreshes of each provider's model list. Default 60.
# MODELS_REFRESH_MIN=60

# Also scan system and developer messages (default off: they are usually your own text)
# SCAN_SYSTEM=1

# One JSON line per request for log pipelines: stdout, stderr, or a file path (see LOGGING.md)
# ACCESS_LOG=stdout
